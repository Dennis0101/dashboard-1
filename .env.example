## Database
# Vercel Postgres(또는 외부 Postgres)의 connection string
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DBNAME"

## iOS Shortcut deposit webhook security
# iOS 단축어에서 HMAC 서명에 사용하는 공유 시크릿(최소 32+ chars 권장)
IOS_WEBHOOK_SECRET="replace_me"
# 허용할 iOS device id(쉼표로 구분). 비워두면 모든 device_id 허용(권장 X)
IOS_ALLOWED_DEVICE_IDS="iphone-1,iphone-2"
# 타임스탬프 허용 오차(ms). 기본 120000(2분)
IOS_MAX_SKEW_MS="120000"

## Discord (Interactions/Webhook)
DISCORD_PUBLIC_KEY="replace_me"          # Interactions Verify Key
DISCORD_APPLICATION_ID="replace_me"
DISCORD_BOT_TOKEN="replace_me"          # 커맨드 등록/팔로업 전송에 사용
DISCORD_ADMIN_WEBHOOK_URL=""           # (선택) 관리자 알림용 Discord Incoming Webhook URL

## Admin guard
# Cron/Admin API 보호용(랜덤 32+ chars)
ADMIN_CRON_SECRET="replace_me"
# 관리자 역할 ID(쉼표로 구분). Discord role 기반 보호에 사용
DISCORD_ADMIN_ROLE_IDS="123,456"

## Fees & pricing
# 운영 수수료(원) - 정수
OPERATOR_FEE_KRW="5000"
# 김프 가산 비율(bps). 예: 150 = 1.50%
KIMCHI_PREMIUM_BPS="150"

## Transfer provider (운영에서는 custody/지갑 제공자 연동)
# mock | provider
TRANSFER_PROVIDER="mock"

